rules_version = '2';

// =============================================================================
// GoInspect — Firestore Security Rules  (COMPLETE — matches the live app)
// -----------------------------------------------------------------------------
// Replaces the wide-open test-mode rules (allow read,write: if true) WITHOUT
// breaking the app: every collection/path the app and admin panel actually use
// is covered, with per-user / shared / admin scoping. Anything else is denied.
//
// HOW TO DEPLOY SAFELY (rules are instant + instantly reversible; they never
// touch data — they only gate access):
//   1. Firebase Console > Firestore > Rules > paste this.
//   2. Rules Playground — simulate (all should match the comment):
//        - user reads OWN backups/{id} (userEmail == them)        -> ALLOW
//        - user reads SOMEONE ELSE'S backups/{id}                 -> DENY
//        - user reads a backup SHARED with them (in sharedWith)   -> ALLOW
//        - user writes _timeSync/temp_x (calibration)             -> ALLOW
//        - normal user reads settings/ayieConfig (AI keys)        -> ALLOW (Phase 1)
//        - normal user reads settings/appConfig                   -> DENY
//        - admin reads users (collection), trackInspections, etc. -> ALLOW
//   3. Test the real app end-to-end with a NORMAL account AND an ADMIN account
//      AND a shared project, BEFORE relying on it. Keep the old rules handy to
//      revert if anything is denied unexpectedly.
//
// EMAIL CASE: the app keys everything lowercased; we compare token.email.lower().
// AI KEYS: Phase 1 keeps settings/ayieConfig readable by any signed-in user so
// AI features keep working with no code change (rotate the keys + set billing
// caps, since a logged-in user can still extract them). Phase 2 (recommended):
// move AI calls to a Cloud Function proxy, then switch ayieConfig read to admin.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // Lower-cased email of the signed-in user (or '' if not signed in / no email).
    function myEmail() {
      return (isSignedIn() && request.auth.token.email != null)
        ? request.auth.token.email.lower() : '';
    }

    // Hardcoded super admin (mirrors admin_panel SUPER_ADMIN_EMAIL).
    function isSuperAdmin() {
      return isSignedIn() && myEmail() == 'team.gohomeinspection@gmail.com';
    }

    // Admin = super admin, OR has an admins/{email} doc (admin panel model),
    // OR users/{email}.isAdmin == true / accountType == 'admin' (app model).
    // get()/exists() bypass rules (no recursion). Cheap checks are placed first
    // at each call site so normal users rarely trigger these reads.
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin()
        || exists(/databases/$(database)/documents/admins/$(myEmail()))
        || (
             exists(/databases/$(database)/documents/users/$(myEmail()))
             && (
                  get(/databases/$(database)/documents/users/$(myEmail())).data.isAdmin == true
               || get(/databases/$(database)/documents/users/$(myEmail())).data.accountType == 'admin'
             )
           )
      );
    }

    function ownsByEmailField() {
      return isSignedIn() && resource.data.userEmail == myEmail();
    }
    function creatingOwnByEmailField() {
      return isSignedIn() && request.resource.data.userEmail == myEmail();
    }
    // True when the current user is listed in the doc's sharedWith[] array.
    function isSharedWithMe() {
      return isSignedIn()
        && ('sharedWith' in resource.data)
        && (resource.data.sharedWith is list)
        && (myEmail() in resource.data.sharedWith);
    }

    // ---- users/{id} : own profile/quota + AI chat subcollections ----
    // GoInspect keys this collection by EMAIL. Pocket keys the same
    // collection by UID (users/{uid}.pocketId, .name), so an email-only
    // rule denied every Pocket profile write — including the one that
    // mints a Pocket ID, which the whole SOS watcher feature hangs on.
    // Both keys are the signed-in user's own document; neither widens
    // access to anybody else's.
    function ownsUserDoc(id) {
      return isSignedIn() && (id == myEmail() || id == request.auth.uid);
    }
    match /users/{id} {
      allow read, write: if ownsUserDoc(id) || isAdmin();
      // ayieChats / ayieFloatChats and any other per-user subcollection.
      match /{sub=**} {
        allow read, write: if ownsUserDoc(id) || isAdmin();
      }
    }

    // ---- admins/{email} : admin-panel role lookup ----
    match /admins/{email} {
      allow read:  if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ---- backups/{projectId} : inspection projects (userEmail + sharedWith[]) ----
    match /backups/{projectId} {
      // SINGLE-DOC reads (get). A NOT-YET-CREATED project's pre-sync existence read
      // hits a missing doc (resource == null) — allow signed-in users to see "not
      // exists" (no data leak) so first-time sync works. The type-guards inside
      // isSharedWithMe() are safe here because get() evaluates against the real doc.
      allow get: if (resource == null && isSignedIn())
                    || ownsByEmailField() || isSharedWithMe() || isAdmin();
      // QUERIES (list). Firestore authorises a query ONLY if its where-clauses
      // guarantee every result satisfies the rule — it cannot prove the 'is list' /
      // 'in resource.data' type-guards from a query, so those guards make it deny the
      // whole array-contains query ("Check cloud" / "Sync All Files" failed). Keep the
      // list predicates MINIMAL. The app/admin only ever run:
      //   where('userEmail','==', me)               -> owner branch (field always set)
      //   where('sharedWith','array-contains', me)  -> shared branch (Firebase's
      //                                                documented array-membership rule)
      //   unconstrained scan (admin maintenance)    -> isAdmin() (true regardless of
      //                                                resource, authorises full scan)
      // Security is preserved: a query for someone else's docs fails the owner/shared
      // branch and a non-admin can't pass isAdmin(), so no over-listing is possible.
      allow list: if (isSignedIn() && resource.data.userEmail == myEmail())
                     || (isSignedIn() && myEmail() in resource.data.sharedWith)
                     || isAdmin();
      allow create: if creatingOwnByEmailField() || isAdmin();
      // owner, a shared collaborator, or admin may sync/edit. (A non-owner who is
      // neither shared nor admin fails ownsByEmailField/isSharedWithMe -> denied,
      // so no hijack is possible.)
      allow update: if ownsByEmailField() || isSharedWithMe() || isAdmin();
      allow delete: if ownsByEmailField() || isAdmin();
    }

    // ---- trackInspections/{id} : repair-tracking docs (userEmail) ----
    match /trackInspections/{id} {
      allow read:   if (resource == null && isSignedIn()) || ownsByEmailField() || isAdmin();
      allow create: if creatingOwnByEmailField() || isAdmin();
      allow update: if ownsByEmailField() || isAdmin();
      allow delete: if ownsByEmailField() || isAdmin();
    }

    // ---- homeSurveys/{accountEmail} : Survey module (doc id == email) ----
    match /homeSurveys/{accountEmail} {
      allow read, write: if (isSignedIn() && accountEmail == myEmail()) || isAdmin();
      match /{sub=**} {
        allow read, write: if (isSignedIn() && accountEmail == myEmail()) || isAdmin();
      }
    }

    // ---- assignedInspections/{id} : admin-created assignments (userEmail) ----
    // The assigned user reads their own; only admin creates/updates/deletes.
    match /assignedInspections/{id} {
      allow read:  if ownsByEmailField() || isAdmin();
      allow write: if isAdmin();
    }

    // ---- inspectionBackups/{id} : admin cleanup only ----
    match /inspectionBackups/{id} {
      allow read, write: if isAdmin();
    }

    // ---- userGroups/{id} : admin-only management ----
    match /userGroups/{id} {
      allow read, write: if isAdmin();
    }

    // ---- orders/{orderId} : customer reads own; writes admin/server only ----
    match /orders/{orderId} {
      allow read:  if ownsByEmailField() || isAdmin();
      allow write: if isAdmin();
    }

    // ---- settings : some docs the APP reads as a normal user, others admin-only.
    // The specific blocks below grant signed-in read where the app needs it; the
    // wildcard makes every OTHER settings doc admin-only. (Firestore allows a
    // request if ANY matching rule allows it, so specific-allow wins over the
    // wildcard for these docs.) Writes always admin-only.
    // pocketConfig: Pocket membacanya pada SETIAP log masuk sebagai pengguna
    // biasa (loadConfig). Ia tiada di sini sebelum ini, jadi bacaan itu
    // ditolak — dan kerana kedua-dua dokumen dibaca bersama, penolakan itu
    // turut membunuh bacaan ayieConfig dan setiap ciri AI bersamanya.
    match /settings/pocketConfig     { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /settings/ayieConfig       { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /settings/ayieTalkConfig   { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /settings/appLinks         { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /settings/voiceCorrections { allow read: if isSignedIn(); allow write: if isAdmin(); }
    // appConfig, trackTimeline, and any future settings: admin-only. Anything
    // the app reads as a normal user must be listed ABOVE, or the read is
    // refused — and a refused read takes its companion read down with it.
    match /settings/{doc}            { allow read, write: if isAdmin(); }

    // ---- clock calibration + ping : public read, signed-in write ----
    // The app writes a throwaway _timeSync/temp_<ts> doc to read serverTime, then
    // deletes it (and an admin button batch-cleans old ones) — both need write.
    match /_timeSync/{doc} { allow read: if true; allow write: if isSignedIn(); }
    match /_ping/{doc}     { allow read: if true; allow write: if isSignedIn(); }

    // ===========================================================================
    // OTHER APPS sharing this same Firebase project (NOT part of the GoInspect
    // app/admin audited here). Their rules are PRESERVED so deploying this file
    // does NOT break them. Without these explicit blocks the default-deny below
    // would lock them out. TODO: tighten these once each app's code is reviewed.
    // ===========================================================================

    // Contractor Job Mode (existing deployed rules, kept verbatim).
    match /contractorJobs/{jobId} {
      allow create: if request.auth != null;
      allow read:   if true;
      allow update, delete: if request.auth != null
        && request.auth.token.email == resource.data.userEmail;

      match /quotations/{qId} {
        allow create: if true;
        allow read, update, delete: if request.auth != null
          && get(/databases/$(database)/documents/contractorJobs/$(jobId)).data.userEmail == request.auth.token.email;
      }
    }

    // Other apps' collections — preserved as currently-open to avoid breakage.
    // (These were covered by the old `match /{document=**}: if true`.)
    match /pocketChats/{p=**}        { allow read, write: if true; }
    match /pocketInspections/{p=**}  { allow read, write: if true; }
    match /siteSessions/{p=**}       { allow read, write: if true; }
    match /ssDocuments/{p=**}        { allow read, write: if true; }
    match /ssPropertyProfile/{p=**}  { allow read, write: if true; }
    match /ssRenovation/{p=**}       { allow read, write: if true; }
    match /ssSchedule/{p=**}         { allow read, write: if true; }

    // ===========================================================================
    // POCKET — SOS lone-worker watch, Pocket ID directory, Pocket admins.
    //
    // Without these blocks the default-deny below rejected every write the
    // SOS feature makes. A rejected write does not queue and retry: it is
    // refused for good. So the alarm never reached anybody, the watcher
    // never saw the watch, and the app showed "Alarm queued" while nothing
    // had been sent. Safety features fail silently or not at all.
    // ===========================================================================

    // Pocket's own admin list is keyed by UID (the app reads its OWN doc to
    // learn whether it should show the watch pane).
    function isPocketAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/pocketAdmins/$(request.auth.uid));
    }

    match /pocketAdmins/{uid} {
      allow get:   if isSignedIn() && uid == request.auth.uid;
      allow list:  if isAdmin();
      allow write: if isAdmin();
    }

    // ---- pocketIds/{CODE} : the six-character directory ----
    // A code is meant to be handed to a colleague, so any signed-in user may
    // look ONE up by its exact code. Listing is denied: the directory is not
    // a phone book to be harvested. A row may only be claimed for, or
    // released by, its own owner.
    match /pocketIds/{code} {
      allow get:    if isSignedIn();
      allow list:   if isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
                       && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- sosWatch/{uid} : live status of one person being watched ----
    // Only the person writes their own row. The person they NAMED as their
    // watcher may read it, and so may an admin — that is the whole point of
    // the feature. The app's queries are:
    // Up to three people may be named. watcherUid is the first of them and
    // stays for older clients and the admin panel; watcherUids is the list
    // every watcher's own query matches on.
    //   watcher : where('watcherUid','==',me).where('active','==',true)
    //             where('watcherUids','array-contains',me).where('active','==',true)
    //   admin   : where('active','==',true)
    match /sosWatch/{uid} {
      allow read, write: if isSignedIn() && uid == request.auth.uid;
      allow get:  if isSignedIn() && resource.data.watcherUid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.watcherUid == request.auth.uid;
      allow get:  if isSignedIn() && request.auth.uid in resource.data.watcherUids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.watcherUids;
      allow read: if isPocketAdmin() || isAdmin();
    }

    // ---- sosAlerts/{id} : an alarm that has gone out ----
    // The sender may create it and mark it a false alarm afterwards. The
    // named watcher and admins may read it and mark it handled. Queries:
    //   watcher : where('toUid','==',me).where('resolved','==',false)
    //             where('toUids','array-contains',me).where('resolved','==',false)
    //   admin   : where('toAdmin','==',true).where('resolved','==',false)
    match /sosAlerts/{id} {
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow get, list: if isSignedIn() && resource.data.fromUid == request.auth.uid;
      allow get, list: if isSignedIn() && resource.data.toUid == request.auth.uid;
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.toUids;
      allow get, list: if (isPocketAdmin() || isAdmin()) && resource.data.toAdmin == true;
      allow update: if isSignedIn() && (
                         resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid
                      || request.auth.uid in resource.data.toUids
                      || isPocketAdmin() || isAdmin());
      allow delete: if isAdmin();
    }

    // ---- default deny everything else ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
