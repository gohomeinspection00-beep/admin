rules_version = '2';

// =============================================================================
// GoInspect — Firebase Storage Security Rules  (COMPLETE — matches the live app)
// -----------------------------------------------------------------------------
// Replaces wide-open test mode WITHOUT breaking uploads. Covers every prefix the
// app/admin upload to: inspections/, surveys/, trackInspections/ (per-user), and
// assignments/ (admin-only, no email in the path). Reads stay public because the
// app shares tokenized download URLs across devices. OTHER apps sharing this same
// bucket (contractor_jobs/, ss_documents/) are preserved as-is so they don't break.
// Everything else denied.
//
// DEPLOY SAFELY (instant + reversible; rules never touch the stored bytes):
//   1. Firebase Console > Storage > Rules > paste this.
//   2. Rules Playground — simulate:
//        - user uploads inspections/<theirEmail>/...      -> ALLOW
//        - user uploads inspections/<otherEmail>/...      -> DENY
//        - user uploads trackInspections/<theirEmail>/... -> ALLOW
//        - admin uploads assignments/...                  -> ALLOW
//        - read any covered path                          -> ALLOW
//   3. Test real uploads with a normal account AND the admin (Track migration +
//      assignment photo upload) BEFORE relying on it. Keep old rules to revert.
//
// NOTE: reads remain `if true` (download URLs carry an access token and are
// shared across devices). This means a known/guessed path stays readable; the
// real protection here is locking WRITES (no overwrite/delete by strangers).
// EMAIL CASE: compared lowercased, matching the app's path convention.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function myEmail() {
      return (isSignedIn() && request.auth.token.email != null)
        ? request.auth.token.email.lower() : '';
    }
    function isSuperAdmin() {
      return isSignedIn() && myEmail() == 'team.gohomeinspection@gmail.com';
    }
    // Storage rules may read Firestore to recognise admins (admins/{email} doc or
    // users/{email}.isAdmin), so the admin's Track-migration cross-user uploads
    // and assignment uploads are allowed.
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin()
        || firestore.exists(/databases/(default)/documents/admins/$(myEmail()))
        || (
             firestore.exists(/databases/(default)/documents/users/$(myEmail()))
             && (
                  firestore.get(/databases/(default)/documents/users/$(myEmail())).data.isAdmin == true
               || firestore.get(/databases/(default)/documents/users/$(myEmail())).data.accountType == 'admin'
             )
           )
      );
    }

    // Inspection photos: inspections/<email>/<projectId>/<file>
    match /inspections/{accountEmail}/{allPaths=**} {
      allow read:  if true;
      allow write: if (isSignedIn() && accountEmail == myEmail()) || isAdmin();
    }

    // Home Survey photos: surveys/<email>/<unitId>/<file>
    match /surveys/{accountEmail}/{allPaths=**} {
      allow read:  if true;
      allow write: if (isSignedIn() && accountEmail == myEmail()) || isAdmin();
    }

    // Track Your Inspection photos: trackInspections/<email>/<trackId>/<file>
    match /trackInspections/{accountEmail}/{allPaths=**} {
      allow read:  if true;
      allow write: if (isSignedIn() && accountEmail == myEmail()) || isAdmin();
    }

    // Admin assignment photos: assignments/<file> (flat prefix, no email segment)
    // -> must be admin-gated, not owner-by-path.
    match /assignments/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // OTHER APPS sharing this same Storage bucket (NOT part of GoInspect). Their
    // files are PRESERVED as currently-open so deploying this file does NOT break
    // them. Confirmed present in Storage > Files: contractor_jobs/, ss_documents/.
    // (These mirror the contractorJobs / ssDocuments Firestore collections that
    // firestore.rules also preserves.) Without these explicit blocks the
    // default-deny below would lock them out. TODO: tighten once each app's code
    // is reviewed.
    // =========================================================================
    match /contractor_jobs/{allPaths=**} { allow read, write: if true; }
    match /ss_documents/{allPaths=**}    { allow read, write: if true; }

    // Everything else: deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
