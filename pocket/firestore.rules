rules_version = '2';

// =============================================================================
// GoXpert Pocket — Firestore Rules (projek Firebase SENDIRI, berasingan
// daripada Go Inspect)
// -----------------------------------------------------------------------------
// Semua data Pocket disimpan di bawah UID pengguna, jadi rules ini ringkas:
// setiap orang hanya boleh baca/tulis cabang miliknya sendiri.
//
// Ini menggantikan rules lama yang terbuka (allow read, write: if true) dan
// sekali gus membetulkan tiga isu yang direkod dalam POCKET-README.md:
//   P1 — data Pocket terdedah kepada umum
//   P2 — settings/pocketConfig tak boleh dibaca pengguna biasa
//   P3 — users/{uid} ditolak kerana rules lama menjangka users/{email}
//
// PERLU DIPASANG SEMULA selepas Messages (v1.9): fail ini kini merangkumi
// pocketIds, pocketAdmins, sosWatch, sosAlerts dan pocketRooms. Tanpa itu
// Pocket ID, SOS dan Messages akan ditolak secara senyap oleh peraturan
// penolak-semua di hujung fail. Salin fail ini ke Firebase Console >
// Firestore > Rules.
//
// Untuk menjadikan satu akaun sebagai admin: Firestore > mulakan koleksi
// pocketAdmins, dokumen bernama UID akaun itu (Authentication > Users),
// tanpa medan. Admin melihat semua amaran SOS.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Pemilik cabang data: UID dalam path mesti sama dengan UID yang log masuk.
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Inspection + foto + BARIS ----
    match /pocketInspections/{uid}/{rest=**} {
      allow read, write: if isOwner(uid);
    }

    // ---- Sejarah chat AI ----
    match /pocketChats/{uid}/{rest=**} {
      allow read, write: if isOwner(uid);
    }

    // ---- Arkib sesi Site Mode ----
    match /siteSessions/{uid}/{rest=**} {
      allow read, write: if isOwner(uid);
    }

    // ---- Profil sendiri ----
    // Pocket menulis users/{uid} semasa signup. Rules ini sepadan dengan itu.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{sub=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- Konfigurasi app ----
    // Dibaca oleh app (pocketConfig, ayieConfig). Tulis HANYA dari Firebase
    // Console atau Admin SDK — 'if false' tidak menghalang kedua-duanya kerana
    // keduanya memintas rules sepenuhnya.
    match /settings/{doc} {
      allow read:  if signedIn();
      allow write: if false;
    }


    // ---- Pocket ID: kod pendek yang boleh diberi kepada orang lain ----
    // get dibenarkan supaya sesiapa boleh menukar kod jadi UID semasa
    // memasang Site safety. list TIDAK dibenarkan, supaya tiada siapa
    // boleh membaca senarai penuh pengguna.
    match /pocketIds/{code} {
      allow get:    if signedIn();
      allow list:   if false;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Penanda admin. Dibuat dari Firebase Console sahaja. ----
    match /pocketAdmins/{uid} {
      allow get:   if isOwner(uid);
      allow list:  if false;
      allow write: if false;
    }
    function isPocketAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/pocketAdmins/$(request.auth.uid));
    }

    // ---- Site safety: status hidup seorang pekerja seorang diri ----
    // Dibaca oleh pemilik, oleh orang yang dinamakan sebagai pemerhati,
    // dan oleh admin. Hanya pemilik boleh menulis.
    match /sosWatch/{uid} {
      allow get, list: if isOwner(uid)
                       || (signedIn() && resource.data.watcherUid == request.auth.uid)
                       || isPocketAdmin();
      allow create, update: if isOwner(uid)
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(uid);
    }

    // ---- Amaran SOS ----
    // Penghantar mencipta; penerima (atau admin) membaca dan menanda
    // selesai. Amaran tidak boleh dipadam — rekod kecemasan kekal.
    match /sosAlerts/{id} {
      allow get, list: if signedIn() && (
                            resource.data.fromUid == request.auth.uid
                         || resource.data.toUid == request.auth.uid
                         || (resource.data.toAdmin == true && isPocketAdmin())
                       );
      // Kos: isPocketAdmin() membaca satu dokumen setiap kali, jadi dua
      // semakan medan yang murah diletak dahulu.
      allow create: if signedIn()
                    && request.resource.data.fromUid == request.auth.uid;
      allow update: if signedIn() && (
                            resource.data.fromUid == request.auth.uid
                         || resource.data.toUid == request.auth.uid
                         || (resource.data.toAdmin == true && isPocketAdmin())
                       );
      allow delete: if false;
    }

    // ---- Messages: chat peribadi dan kumpulan antara pengguna ----
    // NAMA: pocketRooms, bukan pocketChats. pocketChats sudah dipakai
    // oleh sejarah chat AI (satu cabang per UID) di atas.
    //
    // Senarai `members` ialah kunci keselamatannya. Pertanyaan senarai
    // bilik menggunakan array-contains pada medan itu, jadi peraturan
    // read yang sama melindungi get dan list sekali gus: kalau UID awak
    // tiada dalam senarai, pelayan yang menolak, bukan UI.
    match /pocketRooms/{roomId} {
      function member() {
        return signedIn() && request.auth.uid in resource.data.members;
      }
      allow get, list: if member();

      // Pencipta mesti memasukkan dirinya sendiri; kalau tidak sesiapa
      // boleh membuat bilik bagi pihak orang lain.
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.members.size() >= 2
                    && request.resource.data.members.size() <= 50;

      // Ahli mengemas kini ringkasan mesej terakhir dan senarai ahli.
      // Tiada siapa boleh mengeluarkan dirinya daripada senarai orang
      // lain tanpa kekal ahli dahulu, dan bilik tidak boleh dikosongkan.
      allow update: if member()
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.members.size() >= 2
                    && request.resource.data.members.size() <= 50;

      allow delete: if false;

      function roomMember() {
        return signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/pocketRooms/$(roomId)).data.members;
      }

      match /messages/{msgId} {
        allow get, list: if roomMember();
        // Penghantar mesti dirinya sendiri: tiada siapa boleh menulis
        // mesej atas nama orang lain.
        allow create: if roomMember() && request.resource.data.by == request.auth.uid;
        // Mesej yang sudah dibaca orang lain tidak boleh diubah isinya;
        // hanya penghantar boleh menariknya balik.
        allow update, delete: if signedIn() && resource.data.by == request.auth.uid;
      }
    }

    // ---- Tolak semua yang lain ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
