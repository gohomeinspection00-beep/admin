rules_version = '2';

// =============================================================================
// GoXpert Pocket — Cloud Storage Rules
// -----------------------------------------------------------------------------
// Foto defect, fail model 3D, pelan lantai dan video endoscope disimpan di sini,
// BUKAN sebagai base64 dalam dokumen Firestore. Ini membetulkan isu P5 (had 1 MiB
// setiap dokumen) dan P4 (kos baca berulang) dalam POCKET-README.md.
//
// Susunan path:
//   pocket/{uid}/inspections/{inspId}/photos/{fail}   — foto defect
//   pocket/{uid}/inspections/{inspId}/files/{fail}    — 3D, pelan lantai, video
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---- Foto defect: imej sahaja, maksimum 10 MB ----
    match /pocket/{uid}/inspections/{inspId}/photos/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ---- Fail besar: model 3D, pelan lantai, video endoscope. Maksimum 200 MB ----
    match /pocket/{uid}/inspections/{inspId}/files/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource.size < 200 * 1024 * 1024;
    }

    // ---- Tolak semua yang lain ----
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
